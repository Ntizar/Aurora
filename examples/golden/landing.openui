root = Pagina([barra, hero, cifras, features, aviso, cierre], "contenido")
barra = Navegacion("Ntizar · Encargos", ["Producto", "Ficha"], ["index.html", "detalle.html"], "index.html")
hero = Seccion([t1, entradilla, acciones])
t1 = Titular("Un tablero para tus encargos que no se rompe ni en el móvil", "1")
entradilla = Entradilla("Encargos, plazos y estados en una sola pantalla. Aurora pinta la interfaz, tú pones los datos: azul para estructura, naranja para el dato que importa.", "lg")
acciones = Fila([cta1, cta2], "compacto")
cta1 = Boton("Ver la ficha de un encargo", "primario", "lg", false, "detalle.html")
cta2 = Boton("Ver el repositorio", "contorno", "lg", false, "https://github.com/Ntizar/Aurora")
cifras = Rejilla([k1, k2, k3, k4], "4")
k1 = Kpi("Encargos activos", "18", "esta semana", "plano")
k2 = Kpi("Plazo medio", "4,2 días", "-0,8 d", "sube")
k3 = Kpi("Sin plazo asignado", "2", "requieren revisión", "plano", "acento")
k4 = Kpi("Entregadas a tiempo", "94 %", "+3 pp", "sube")
features = Seccion([t2, rejilla], "Qué hace", true)
t2 = Titular("Tres cosas bien hechas, ni una más", "2")
rejilla = Rejilla([f1, f2, f3])
f1 = Tarjeta([d1], "Cola por prioridad", true)
d1 = Texto("Cada encargo entra por su cola y sale por fecha comprometida. Sin columnas fantasma ni arrastrar tarjetas para aparentar que trabajas.")
f2 = Tarjeta([d2], "Estado honesto", true)
d2 = Texto("Borrador, en curso, revisión o entregado: el estado es el dato y no un adorno de color. El naranja se reserva para lo que no puede esperar.")
f3 = Tarjeta([d3], "Ficha con historial", true)
d3 = Texto("Abrir un encargo muestra sus partidas, sus fechas y lo que ya estaba decidido. Volver al inicio siempre es un enlace, no una esperanza.")
aviso = Aviso("Esta página es un producto de muestra", "Se generó desde examples/golden/landing.openui con modo producto y ruta de inicio declarada: la marca lleva al inicio y ningún destino es un placeholder.", "info")
cierre = Seccion([t3, cta3], "Siguiente paso", true)
t3 = Titular("Abre la ficha y vuelve por el enlace de la marca", "2")
cta3 = Boton("Abrir la ficha de encargo", "primario", "md", false, "detalle.html")
