root = Pagina([barra, apertura, cifras, generativa, contraste, tuyo, mapas, cierre], "contenido")
barra = Navegacion("Aurora", ["Catálogo", "Generative UI", "Marcas", "Recetas"])
apertura = Seccion([t1, claim, acciones])
t1 = Titular("El diseño lo escribe un modelo. Aurora impide que quede mal.", "1")
claim = Entradilla("2.195 objetos verificados, 36 componentes generativos y cinco arquetipos para webs, paneles, mapas e informes. Una clase inventada es imposible por construcción. Y la marca es tuya: dos colores y el sistema entero se rehace.", "lg")
acciones = Fila([cta1, cta2, cta3], "compacto")
cta1 = Boton("Escribir un programa", "primario")
cta2 = Boton("Ver el catálogo", "contorno")
cta3 = Boton("Poner tu marca", "contorno")
cifras = Rejilla([k1, k2, k3, k4], "4")
k1 = Kpi("Objetos verificados", "2.195", "uno por uno", "plano")
k2 = Kpi("Componentes generativos", "36", "vocabulario cerrado", "plano")
k3 = Kpi("Clases inventadas", "0", "por construcción", "plano", "acento")
k4 = Kpi("Marcas listas", "6", "+ la tuya en 60 s", "sube")
generativa = Seccion([t2, g1, g2], "Cómo cabe todo", true)
t2 = Titular("Cuatro capas, un solo contrato", "2")
g1 = Texto("L0 marcas: la identidad. L1 packs: la implementación, 18 hojas de estilo. L2 openui: el vocabulario que escribe el modelo. L3 arquetipos: cinco estructuras ya decididas. El programa valida tipos, enums y aridad antes de tocar el DOM.")
g2 = Nota("Sin gradiente, sin glass, sin negritas a mano: las leyes del contrato las impone el runtime, no la buena fe del modelo.")
contraste = Seccion([t3, par], "El mismo encargo, dos destinos", true)
t3 = Titular("La diferencia no es el modelo: es el sistema", "2")
par = DosColumnas([sin], [con], "50-50")
sin = Tarjeta([s1, sn], "Sin sistema", true)
s1 = Texto("Pantalla de inicio con degradado azul→morado, tarjetas de esquinas imposibles y cuatro negritas que gritan a la vez. Bonita en la captura, inservible en el móvil.")
sn = Nota("IA-slop: cada generación, un idioma visual distinto.", "nota")
con = Tarjeta([c1, barras, tabla], "Con Aurora", true)
c1 = Kpi("Puntualidad", "94,2 %", "+2,1 pp", "sube", "acento")
barras = Barras(["L", "M", "X", "J", "V", "S", "D"], [186, 204, 198, 212, 226, 152, 106])
tabla = Tabla(["Ruta", "Salidas", "Puntualidad"], [["MAD-BCN", "42", "96 %"], ["MAD-VLC", "31", "88 %"]], true, "comoda", false, "Salidas")
tuyo = Seccion([t4, chips, tn], "Hazlo tuyo en sesenta segundos", true)
t4 = Titular("No es mi azul y mi naranja", "2")
chips = Fila([ch1, ch2, ch3, ch4, ch5], "compacto")
ch1 = Chip("Aurora", "neutro")
ch2 = Chip("Índigo", "neutro")
ch3 = Chip("Violeta", "neutro")
ch4 = Chip("Carmesí", "neutro")
ch5 = Chip("Esmeralda", "neutro")
tn = Nota("Dos colores de cualquier marca real y generar-marca.py saca la rampa OKLCH con contraste AA, sombras, fondos suaves y modo oscuro. El punto de partida no es el branding de Ntizar: es el tuyo.")
mapas = Seccion([t5, mp], "Y mapas, claro", true)
t5 = Titular("El bastidor del mapa también es diseño", "2")
mp = Texto("Marco, leyenda, controles flotantes y ficha emergente salen del censo; la librería de tiles es tuya: MapLibre, Leaflet o el proveedor que quieras. Aurora no posee el motor: posee su cara.")
cierre = Seccion([t6, pasos], "Por dónde empezar", true)
t6 = Titular("Cuatro pasos", "2")
pasos = Pasos(["Elige tus dos colores", "Pide un panel al modelo", "Sella con el lint", "Publica en el canal vivo"], 1)
