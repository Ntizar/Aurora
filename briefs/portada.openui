root = Pagina([barra, apertura, cifras, generativa, contraste, puertas, marcas, codigo], "contenido")
barra = Navegacion("Aurora", ["Catálogo", "Bloques", "Marcas", "OpenUI", "GitHub"], ["base.html", "bloques/recetas/index.html", "marcas/index.html", "openui/index.html", "https://github.com/Ntizar/Aurora"])
apertura = Seccion([t1, claim, acciones])
t1 = Titular("El modelo escribe el diseño. Aurora no le deja equivocarse.", "1")
claim = Entradilla("{{OBJETOS}} clases verificadas en {{FAMILIAS}} familias, {{PACKS}} hojas CSS sin build y un lenguaje de 36 componentes. Lo escribe un modelo o lo escribes tú: el contrato es el mismo y no se negocia.", "lg")
acciones = Fila([cta1, cta2, cta3], "compacto")
cta1 = Boton("Probar OpenUI", "primario", "lg", false, "openui/index.html")
cta2 = Boton("Ver el catálogo", "contorno", "lg", false, "base.html")
cta3 = Boton("Poner tu marca", "contorno", "lg", false, "marcas/index.html")
cifras = Rejilla([k1, k2, k3, k4], "4")
k1 = Kpi("Clases verificadas", "{{OBJETOS}}", "en {{FAMILIAS}} familias", "plano")
k2 = Kpi("Hojas CSS", "{{PACKS}}", "sin build ni dependencias", "plano")
k3 = Kpi("Clases inventadas", "0", "no compilan", "plano", "acento")
k4 = Kpi("Marcas listas", "{{MARCAS}}", "+ la tuya en un minuto", "sube")
generativa = Seccion([t2, e2, g1, pasos, aviso], "OpenUI", true)
t2 = Titular("La portada es un programa, no un HTML que nadie revisa", "2")
e2 = Entradilla("openui-lang es un lenguaje de bolsillo: 36 componentes, argumentos posicionales y una decisión por línea. El modelo describe la página y el compilador comprueba tipos, enums y aridad contra el censo antes de pintar nada.", "sm")
g1 = Texto("De ahí sale el ahorro: el marcado de una portada así ronda los 3.700 tokens, y releerlo y reescribirlo en cada cambio es donde se va el tiempo. El programa son unos 1.200, se lee entero de un vistazo y no admite clases de la casa: lo que no está en el vocabulario no compila.")
pasos = Pasos(["Escribe el encargo en JSON", "El modelo devuelve el programa", "programa-a-html.py compila y el lint sella"], 1)
aviso = Aviso("Esta portada es su propio programa", "Abajo está el fichero completo, tal cual. Se hornea con scripts/hornear.py: el HTML que estás leyendo no se ha escrito a mano ni una línea.", "info")
contraste = Seccion([t3, par], "Comparación", true)
t3 = Titular("La diferencia no es el modelo: es el sistema", "2")
par = DosColumnas([sin], [con], "50-50")
sin = Tarjeta([s1, sn], "Sin sistema", true)
s1 = Texto("Degradado azul→morado, tarjetas de esquinas imposibles, cuatro negritas gritando a la vez y una tabla que desborda el móvil. Bonita en la captura, inservible en producción.")
sn = Nota("IA-slop: cada generación inventa un idioma visual nuevo.", "peligro")
con = Tarjeta([c1, avan, tabla], "Con Aurora", true)
c1 = Kpi("Puntualidad", "94,2 %", "+2,1 pp", "sube", "acento")
avan = Progreso(94, "Salidas puntuales · 42 de 45")
tabla = Tabla(["Ruta", "Salidas", "Puntualidad"], [["MAD-BCN", "42", "96 %"], ["MAD-VLC", "31", "88 %"]], true, "comoda", false, "Salidas")
puertas = Seccion([t4, rejillaPuertas], "Empezar", true)
t4 = Titular("Tres puertas, el mismo sistema", "2")
rejillaPuertas = Rejilla([f1, f2, f3])
f1 = Tarjeta([p1, b1], "A mano", true)
p1 = Texto("Enlaza tokens.css y los packs que uses desde el CDN y copia un bloque del catálogo. Sin build, sin dependencias y el móvil ya viene resuelto.")
b1 = Boton("Ver bloques", "contorno", "sm", false, "bloques/recetas/index.html")
f2 = Tarjeta([p2b, b2], "Con tu agente", true)
p2b = Texto("Dale LLM.md y components.json: elige clases del censo y auditar-uso.py sella el HTML antes de entregar. El lint no perdona.")
