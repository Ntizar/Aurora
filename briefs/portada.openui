f3 = Tarjeta([p3, b3], "Con un modelo", true)
p3 = Texto("El modelo escribe el programa en el playground y lo ves pintarse en vivo, componente a componente, sin escribir HTML.")
b3 = Boton("Abrir OpenUI", "contorno", "sm", false, "openui/index.html")
marcas = Seccion([t5, m1, chips, tm], "Marca", true)
t5 = Titular("El azul y el naranja son míos; los tuyos se ponen en un minuto", "2")
m1 = Texto("Dos colores de cualquier marca real y generar-marca.py saca la rampa OKLCH con contraste AA, fondos suaves y modo oscuro. Aurora no posee el motor de mapas ni la marca: posee la cara que los hace legibles.")
