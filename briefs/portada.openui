root = Pagina([barra, apertura, cifras, generativa, contraste, formas, tuyo, mapas, cierre, codigo], "contenido")
barra = Navegacion("Aurora", ["Catálogo", "Bloques", "Marcas", "OpenUI"])
apertura = Seccion([t1, claim, acciones])
t1 = Titular("El diseño lo escribe un modelo. Aurora impide que quede mal.", "1")
claim = Entradilla("Aurora es un sistema de diseño con contrato: 2.195 objetos verificados, 18 packs CSS puros sin build y un lenguaje generativo. Webs, paneles, mapas e informes de nivel top, sin IA-slop por construcción, y con la marca que tú decidas.", "lg")
acciones = Fila([cta1, cta2, cta3], "compacto")
cta1 = Boton("Escribir un programa", "primario")
cta2 = Boton("Ver el catálogo", "contorno")
cta3 = Boton("Poner tu marca", "contorno")
cifras = Rejilla([k1, k2, k3, k4], "4")
k1 = Kpi("Objetos verificados", "2.195", "uno por uno", "plano")
k2 = Kpi("Componentes generativos", "36", "vocabulario cerrado", "plano")
k3 = Kpi("Clases inventadas", "0", "imposible por construcción", "plano", "acento")
k4 = Kpi("Marcas listas", "6", "+ la tuya en 60 s", "sube")
generativa = Seccion([t2, g1, g2], "Cómo funciona", true)
t2 = Titular("Cuatro capas, un solo contrato", "2")
g1 = Texto("L0 marcas: la identidad. L1 packs: la implementación, 18 hojas de estilo CSS puro. L2 openui: el vocabulario que escribe el modelo. L3 arquetipos: cinco estructuras ya decididas y auditadas. El programa valida tipos, enums y aridad antes de tocar el DOM, y el runtime emite solo clases del censo.")
g2 = Nota("Sin gradiente, sin glass, sin negritas a mano: las leyes del contrato las impone el runtime y el lint, no la buena fe del modelo.")
contraste = Seccion([t3, par], "El mismo encargo, dos destinos", true)
t3 = Titular("La diferencia no es el modelo: es el sistema", "2")
par = DosColumnas([sin], [con], "50-50")
sin = Tarjeta([s1, sn], "Sin sistema", true)
s1 = Texto("Pantalla de inicio con degradado azul→morado, tarjetas de esquinas imposibles y cuatro negritas que gritan a la vez. Bonita en la captura, inservible en el móvil.")
sn = Nota("IA-slop: cada generación, un idioma visual distinto.", "peligro")
con = Tarjeta([c1, barras, tabla], "Con Aurora", true)
c1 = Kpi("Puntualidad", "94,2 %", "+2,1 pp", "sube", "acento")
barras = Barras(["L", "M", "X", "J", "V", "S", "D"], [186, 204, 198, 212, 226, 152, 106])
tabla = Tabla(["Ruta", "Salidas", "Puntualidad"], [["MAD-BCN", "42", "96 %"], ["MAD-VLC", "31", "88 %"]], true, "comoda", false, "Salidas")
formas = Seccion([t4, rejillaFormas], "Tres formas de construir", true)
t4 = Titular("Entra por donde quieras", "2")
rejillaFormas = Rejilla([f1, f2, f3])
f1 = Tarjeta([pf1, b1], "A mano", true)
pf1 = Texto("Enlaza tokens.css y los packs que uses desde el CDN, copia un bloque del catálogo y pega. Sin build, sin dependencias, móvil resuelto.")
b1 = Boton("Ver bloques", "contorno", "sm")
f2 = Tarjeta([pf2, b2], "Con tu agente", true)
pf2 = Texto("Dale LLM.md y components.json a tu agente: elige clases del censo y auditar-uso.py sella su HTML antes de entregar.")
b2 = Boton("Guía para agentes", "contorno", "sm")
f3 = Tarjeta([pf3, b3], "Con un modelo en caliente", true)
pf3 = Texto("El modelo escribe openui-lang; el parser valida y el runtime pinta. La página que estás leyendo salió así, en 50 líneas.")
b3 = Boton("Abrir el playground", "contorno", "sm")
tuyo = Seccion([t5, chips, tn], "Hazlo tuyo en sesenta segundos", true)
t5 = Titular("No es mi azul y mi naranja", "2")
chips = Fila([ch1, ch2, ch3, ch4, ch5], "compacto")
ch1 = Chip("Aurora", "neutro")
ch2 = Chip("Índigo", "neutro")
ch3 = Chip("Violeta", "neutro")
ch4 = Chip("Carmesí", "neutro")
ch5 = Chip("Esmeralda", "neutro")
tn = Nota("Dos colores de cualquier marca real y generar-marca.py saca la rampa OKLCH con contraste AA, sombras, fondos suaves y modo oscuro. El punto de partida no es el branding de Ntizar: es el tuyo. Pruébalo en vivo en la sección de marcas.")
mapas = Seccion([t6, mp], "Y mapas, claro", true)
t6 = Titular("El bastidor del mapa también es diseño", "2")
mp = Texto("Marco, leyenda, controles flotantes y ficha emergente salen del censo; la librería de tiles es tuya: MapLibre, Leaflet o el proveedor que quieras. Aurora no posee el motor: posee su cara.")
cierre = Seccion([t7, pasos], "Por dónde empezar", true)
t7 = Titular("Cuatro pasos", "2")
pasos = Pasos(["Elige tus dos colores", "Pide un panel al modelo", "Sella con el lint", "Publica en el canal vivo"], 1)
codigo = Seccion([t8, codigoNota], "Esta página es este programa", true)
t8 = Titular("Sin trucos", "2")
codigoNota = Texto("El programa openui-lang que genera esta página viaja embebido abajo y se muestra tal cual: 50 líneas. Compila con programa-a-html.py, pasa el lint y se publica en el canal vivo.")
